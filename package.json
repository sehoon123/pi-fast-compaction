{
  "name": "pi-fast-compaction",
  "version": "0.2.0",
  "description": "Choose a separate compaction model in Pi, with persistent controls, bounded summaries, safe fallback, and a live status bar.",
  "type": "module",
  "license": "MIT",
  "author": "SH Jung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sehoon123/pi-fast-compaction.git"
  },
  "homepage": "https://github.com/sehoon123/pi-fast-compaction#readme",
  "bugs": {
    "url": "https://github.com/sehoon123/pi-fast-compaction/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "compaction",
    "summarization",
    "context"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
